# URL de PRODUCTION du webhook n8n qui reçoit les demandes de devis
# (workflow « Audrey.L Company — Demandes de devis du site », chemin /webhook/audreyl-devis).
# Sans cette variable, le formulaire affiche une erreur et propose WhatsApp.
DEVIS_WEBHOOK_URL=

# Secret partagé avec n8n (envoyé dans l'en-tête x-devis-secret). Même valeur que
# dans le nœud « Secret du site valide ? » du workflow. Ne jamais le committer.
DEVIS_WEBHOOK_SECRET=
